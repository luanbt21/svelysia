{
  "name": "svelysia",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "serve": "bun run --watch src/index.ts",
    "dev": "bun --bun vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "fmt": "bunx oxfmt",
    "lint": "bunx oxlint --type-aware",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.63",
    "@iconify-json/tabler": "^1.2.25",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/bun": "^1.3.5",
    "@unocss/extractor-svelte": "^66.5.10",
    "@unocss/preset-icons": "^66.5.10",
    "@unocss/preset-wind4": "^66.5.10",
    "@vitest/browser-playwright": "^4.0.16",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.35.0",
    "oxlint-tsgolint": "^0.8.6",
    "playwright": "^1.57.0",
    "svelte": "^5.46.1",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.3.5",
    "typescript": "^5.9.3",
    "unocss": "^66.5.10",
    "vite": "^7.3.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.0.16",
    "vitest-browser-svelte": "^2.0.1"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/openapi": "^1.4.12",
    "@elysiajs/opentelemetry": "^1.4.9",
    "@openobserve/pino-openobserve": "^1.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@sinclair/typebox": "^0.34.44",
    "elysia": "^1.4.19",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3"
  }
}
