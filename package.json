{
  "name": "svelysia",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "bun run --watch src/server.ts",
    "dev": "bun --bun vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "fmt": "bunx oxfmt",
    "lint": "bunx oxlint --type-aware",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "bun run test:unit -- --run",
    "db:generate": "zen generate --output ./src/lib/zenstack",
    "db:migrate": "zen migrate",
    "db:studio": "zen studio",
    "auth:schema": "better-auth/cli generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@better-auth/core": "^1.6.11",
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysia/eden": "^1.4.10",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@openobserve/pino-openobserve": "^1.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.215.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@prisma/client": "^7.8.0",
    "@sinclair/typebox": "^0.34.49",
    "@zenstackhq/better-auth": "^3.7.1",
    "@zenstackhq/orm": "^3.7.1",
    "@zenstackhq/schema": "^3.7.1",
    "better-auth": "^1.6.11",
    "elysia": "^1.4.28",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@inlang/paraglide-js": "^2.18.1",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "@vitest/browser-playwright": "^4.1.7",
    "@zenstackhq/cli": "^3.7.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.21.1",
    "playwright": "^1.60.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.55.9",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.4.8",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "^1.0.0-next.7",
