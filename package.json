{
  "name": "svelysia",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "serve": "bun run --watch src/server.ts",
    "dev": "bun --bun vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "fmt": "bunx oxfmt",
    "lint": "bunx oxlint --type-aware",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.81",
    "@iconify-json/tabler": "^1.2.34",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.1",
    "@types/bun": "^1.3.13",
    "@unocss/extractor-svelte": "^66.6.8",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "@vitest/browser-playwright": "^4.1.5",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.21.1",
    "playwright": "^1.59.1",
    "prisma": "^7.8.0",
    "svelte": "^5.55.5",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "vite": "^8.0.11",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.5",
    "vitest-browser-svelte": "^2.1.1"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@openobserve/pino-openobserve": "^1.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.215.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@prisma/client": "^7.8.0",
    "@sinclair/typebox": "^0.34.49",
    "elysia": "^1.4.28",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}